{
  "name": "hesap-makinesi",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.8",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-manipulator": "~57.0.7",
    "expo-image-picker": "~57.0.7",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sensors": "~57.0.2",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-video-thumbnails": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-blob-util": "^0.24.10",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-modules": "^0.36.4",
    "react-native-pdf": "^7.0.4",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "~29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.3",
    "lint-staged": "^17.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:fix": "expo lint --fix",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test:coverage",
    "prepare": "husky"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ],
    "moduleNameMapper": {
      "^react-native-quick-crypto$": "<rootDir>/src/test/quick-crypto-node-shim.ts",
      "^expo-secure-store$": "<rootDir>/src/test/secure-store-mock.ts",
      "^expo-file-system$": "<rootDir>/src/test/file-system-mock.ts",
      "^expo-sqlite$": "<rootDir>/src/test/expo-sqlite-node-shim.ts",
      "^expo-crypto$": "<rootDir>/src/test/expo-crypto-mock.ts",
      "^expo-sharing$": "<rootDir>/src/test/expo-sharing-mock.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/test/**",
      "!**/__tests__/**",
      "!src/app/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 28,
        "branches": 22,
        "functions": 25,
        "lines": 28
      },
      "src/lib/crypto/": {
        "statements": 90,
        "branches": 75,
        "functions": 95,
        "lines": 95
      },
      "src/lib/db/": {
        "statements": 88,
        "branches": 75,
        "functions": 85,
        "lines": 88
      },
      "src/stores/": {
        "statements": 55,
        "branches": 50,
        "functions": 55,
        "lines": 60
      }
    }
  },
  "private": true,
  "engines": {
    "node": ">=23.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --fix",
      "bash -c \"npm run typecheck\""
    ],
    "*.{json,md,yml}": []
  }
}
